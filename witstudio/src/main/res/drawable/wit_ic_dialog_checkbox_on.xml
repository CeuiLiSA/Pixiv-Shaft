        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M6,3 L18,3 A3,3 0 0 1 21,6 L21,18 A3,3 0 0 1 18,21 L6,21 A3,3 0 0 1 3,18 L3,6 A3,3 0 0 1 6,3 Z M10.4,16.8 L6.2,12.6 7.6,11.2 10.4,14 16.4,8 17.8,9.4 Z" />
</vector>
