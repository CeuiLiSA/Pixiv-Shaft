<?xml version="1.0" encoding="utf-8"?>
<!-- MD3-E 分段行背景（独行，即组内只有一行）：四角 20dp。
     wit_menu_bg 实底 + wit_border_2 hairline —— 浅色模式靠这条 hairline 从 #FAFAFA 背景里浮出来
     （近乎零 elevation 是 V3 的刻意选择，层次不靠阴影靠描边）。结构约束见 wit_row_top.xml。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wit_menu_bg" />
            <corners android:radius="20dp" />
            <stroke
                android:width="0.5dp"
                android:color="@color/wit_border_2" />
        </shape>
    </item>
</ripple>
