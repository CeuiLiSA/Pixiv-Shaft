<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="transfer_title">기기 이전</string>
    <string name="transfer_settings_summary">같은 Wi-Fi에서 로컬 데이터를 새 휴대전화로 옮기기</string>
    <string name="transfer_home_title">로컬 데이터를 새 휴대전화로 옮기기</string>
    <string name="transfer_home_body">두 휴대전화를 같은 Wi-Fi에 연결하고 같은 Pixiv 계정으로 로그인하세요. 데이터는 암호화되어 두 기기 간에 직접 전송됩니다.</string>
    <string name="transfer_login_body">이전을 시작하기 전에 Pixiv에 로그인하세요.</string>
    <string name="transfer_login">Pixiv에 로그인</string>
    <string name="transfer_receive">새 휴대전화 · 스캔하여 받기</string>
    <string name="transfer_old_phone">이전 휴대전화 · QR 코드 표시</string>
    <string name="transfer_contents_title">이전할 수 있는 데이터</string>
    <string name="transfer_contents_body">앱 및 다운로드 설정, 숨김 항목, 검색 및 열람 기록, 고정한 태그와 작가, 나중에 보기, 저장한 특집, 동의어 사전, 저장된 계정이 이전됩니다. 다운로드한 파일, 캐시, 시스템 폴더 권한은 별도로 처리합니다.</string>
    <string name="transfer_pair_title">새 휴대전화에서 스캔</string>
    <string name="transfer_pair_body">새 휴대전화에서 ‘스캔하여 받기’를 선택하세요. 이 일회용 QR 코드는 2분 동안 유효합니다.</string>
    <string name="transfer_pair_qr">기기 이전 QR 코드</string>
    <string name="transfer_approve_title">새 휴대전화로 데이터를 보낼까요?</string>
    <string name="transfer_approve_body">두 휴대전화에 표시된 페어링 번호가 같은지 확인하세요. 백업에는 저장된 계정과 앱 설정이 포함됩니다.</string>
    <string name="transfer_comparison">페어링 번호 %1$s</string>
    <string name="transfer_send">확인하고 보내기</string>
    <string name="transfer_scan_title">이전 휴대전화의 QR 코드 스캔</string>
    <string name="transfer_scan_body">이전 휴대전화의 기기 이전 화면에 표시된 QR 코드에 카메라를 맞추세요.</string>
    <string name="transfer_cancel">이전 취소</string>
    <string name="transfer_connecting">연결 준비 중</string>
    <string name="transfer_wait">이전 휴대전화의 확인을 기다리는 중</string>
    <string name="transfer_wait_body">이전 휴대전화에서 페어링 번호를 확인한 후 ‘확인하고 보내기’를 누르세요.</string>
    <string name="transfer_prepare">백업 준비 중</string>
    <string name="transfer_keep_open">두 휴대전화의 Wi-Fi 연결을 유지하고 이전 화면을 열어 두세요.</string>
    <string name="transfer_sending">백업 보내는 중</string>
    <string name="transfer_receiving">백업 받는 중</string>
    <string name="transfer_remote_restore">새 휴대전화에서 복원 중</string>
    <string name="transfer_restoring">데이터 복원 중</string>
    <string name="transfer_percent">%1$d%%</string>
    <string name="transfer_complete">이전 완료</string>
    <string name="transfer_sent_body">새 휴대전화에서 복원을 마쳤습니다. 이 휴대전화의 데이터도 계속 사용할 수 있습니다.</string>
    <string name="transfer_restored_body">로컬 기록을 병합하고 설정을 가져왔습니다. 일부 설정은 앱을 다시 시작하면 적용됩니다.</string>
    <string name="transfer_done">완료</string>
    <string name="transfer_error_title">이전이 완료되지 않음</string>
    <string name="transfer_error_wifi">Wi-Fi로 연결할 수 없습니다. 두 휴대전화가 같은 Wi-Fi에 연결되어 있고 서로 통신할 수 있는지 확인하세요.</string>
    <string name="transfer_error_account">두 휴대전화에서 같은 Pixiv 계정으로 로그인한 후 다시 페어링하세요.</string>
    <string name="transfer_error_timeout">연결 시간이 초과되었습니다. 이전 휴대전화에서 새 QR 코드를 생성하세요.</string>
    <string name="transfer_error_connection">연결에 실패했거나 전송이 중단되었습니다. 두 휴대전화의 Wi-Fi와 저장 공간을 확인한 후 다시 페어링하세요.</string>
    <string name="transfer_error_restore">새 휴대전화에서 이 백업을 복원하지 못했습니다. 저장 공간을 확인하고 두 휴대전화의 앱을 업데이트한 후 다시 시도하세요.</string>
    <string name="transfer_error_status_unknown">이전 휴대전화에서 복원 결과를 확인할 수 없습니다. 새 휴대전화에서 이전 상태를 확인하세요.</string>
    <string name="transfer_status_unknown_title">복원 결과 확인 필요</string>
    <string name="transfer_error_code">이 QR 코드는 기기 이전에 사용할 수 없습니다. 이전 휴대전화의 기기 이전 화면에서 생성한 QR 코드를 스캔하세요.</string>
    <string name="transfer_error_camera_permission">스캔하려면 카메라 권한이 필요합니다. 권한 요청이 다시 표시되지 않으면 시스템 설정에서 카메라를 허용하세요.</string>
    <string name="transfer_error_camera">카메라를 열 수 없습니다. 카메라를 사용하는 다른 앱을 닫은 후 다시 시도하세요.</string>
    <string name="transfer_retry">다시 시도</string>
    <string name="transfer_back">돌아가기</string>
</resources>
