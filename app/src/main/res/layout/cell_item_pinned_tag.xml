<?xml version="1.0" encoding="utf-8"?>
<!--
  「我置顶的内容 → 标签」列表 cell（V3 + MD3-E）。
  和隔壁「作者」tab 的 cell_item_pinned_user 共用同一套卡片语汇（bg_v3_card 卡底 +
  bg_drawer_item_pill ripple + 20dp/16dp 内距，卡间距由列表的 LinearItemDecoration(12dp) 给）——
  两个 tab 是同一页的左右页，卡片不能长得不一样。
  信息层级：译名/标签名 16sp bold / v3_text_1 → 原名副标题 13sp / v3_text_2 → 预览图。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="ceui.pixiv.ui.pinned.PinnedTagItemHolder" />
        <import type="android.view.View" />

        <variable
            name="holder"
            type="PinnedTagItemHolder" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_v3_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/bg_drawer_item_pill"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/delete_pin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/pinned_tag_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@{holder.tag.translated_name != null ? holder.tag.translated_name : holder.tag.name}"
                    android:textColor="@color/v3_text_1"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pinned_tag_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@{holder.tag.name}"
                    android:textColor="@color/v3_text_2"
                    android:textSize="13sp"
                    android:visibility="@{holder.showSubtitle ? View.VISIBLE : View.GONE}" />
            </LinearLayout>

            <ImageView
                android:id="@+id/delete_pin"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/string_443"
                android:padding="10dp"
                android:src="@drawable/ic_cancel_black_24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/v3_text_3" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/illusts_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="@{holder.hasPreview ? View.VISIBLE : View.GONE}">

            <net.csdn.roundview.RoundImageView
                android:id="@+id/illust_1"
                loadSquareMedia="@{holder.illust0}"
                visibleOrInvisible="@{holder.illust0 != null}"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:rRadius="10dp" />

            <net.csdn.roundview.RoundImageView
                android:id="@+id/illust_2"
                loadSquareMedia="@{holder.illust1}"
                visibleOrInvisible="@{holder.illust1 != null}"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="4dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toStartOf="@+id/illust_3"
                app:layout_constraintStart_toEndOf="@+id/illust_1"
                app:layout_constraintTop_toTopOf="parent"
                app:rRadius="10dp" />

            <net.csdn.roundview.RoundImageView
                android:id="@+id/illust_3"
                loadSquareMedia="@{holder.illust2}"
                visibleOrInvisible="@{holder.illust2 != null}"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/illust_2"
                app:layout_constraintTop_toTopOf="parent"
                app:rRadius="10dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</layout>
