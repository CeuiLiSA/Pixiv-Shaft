<?xml version="1.0" encoding="utf-8"?>
<!--
  「我置顶的内容 → 标签」列表 cell（V3 设计哲学）：
  22dp cardSurface（运行时由 V3Palette.cardFill + cardHairline 派生）压在 v3_bg 上，
  与「作者」「搜索历史」三页共用同一套卡片语汇与 720dp 宽屏限宽装饰。
  信息层级：译名 / 标签名（或组合「原神 + 胡桃」）16sp SemiBold / v3_text_1 →
  副标题 13sp / v3_text_2 → 三格 1:1 预览图；末端取消置顶按钮保持 48dp 触控热区。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingVertical="14dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/delete_pin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/pinned_tag_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/v3_text_1"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/pinned_tag_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/v3_text_2"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/delete_pin"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="-10dp"
            android:contentDescription="@string/string_443"
            android:padding="13dp"
            android:src="@drawable/ic_close_black_24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/v3_text_2" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/illusts_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <net.csdn.roundview.RoundImageView
            android:id="@+id/illust_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_tag_preview_placeholder"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/illust_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rRadius="10dp" />

        <net.csdn.roundview.RoundImageView
            android:id="@+id/illust_2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_tag_preview_placeholder"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/illust_3"
            app:layout_constraintStart_toEndOf="@+id/illust_1"
            app:layout_constraintTop_toTopOf="parent"
            app:rRadius="10dp" />

        <net.csdn.roundview.RoundImageView
            android:id="@+id/illust_3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_tag_preview_placeholder"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/illust_2"
            app:layout_constraintTop_toTopOf="parent"
            app:rRadius="10dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
