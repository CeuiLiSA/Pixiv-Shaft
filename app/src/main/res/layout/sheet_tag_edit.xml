<?xml version="1.0" encoding="utf-8"?>
<!--
  issue #1023「编辑标签」MD3-Expressive bottom sheet，取代最初那版 QMUI CustomDialogBuilder。

  骨架与 sheet_mute_tag.xml / sheet_select_tag.xml 一致（拖拽把手 / headline+supporting /
  分割线 / 滚动区 / 底部动作条）——三张 sheet 干的是同一类事（在一堆标签上做增删选），
  不该长成三个样子。

  # 为什么输入框必须钉在滚动区外
  QMUI 那版把「说明 + 标签流 + 输入行」直接堆在一个不滚动的 LinearLayout 里塞进 dialog。
  LinearLayout 在 AT_MOST 下测量子 view 时会把已消耗高度算进 padding（见
  getChildMeasureSpec），前面的 chip 吃光预算后，最后一个子 view 只剩残高：真机实测
  10 个标签（pixiv 上限）的作品输入行被压到 34px，输入框和「添加」整行画不出来，
  恰恰在最需要编辑的作品上不可用。这里把标签流放进 weight=1 的 NestedScrollView、
  输入条留在滚动区外，标签再多也只是滚动区变矮，输入条恒定可见。

  # 主题
  root 挂 Theme.Material3.DayNight.NoActionBar（同 sheet_mute_tag.xml）：本 App 主题继承
  QMUI、不含 MD3 属性，不套这层则 MaterialButton / TextInputLayout /
  BottomSheetDragHandleView 全部 inflate 不出来。代价是 colorPrimary 退回 MD3 基线紫，
  所以强调色一律由 Kotlin 侧用 V3Palette 运行时 tint（见 TagEditSheet.applyAccent）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_m3e_sheet_top"
    android:orientation="vertical"
    android:theme="@style/Theme.Material3.DayNight.NoActionBar">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/drag_handle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />

    <!-- 标题行：MD3-E 的 headline + supporting 双行排版 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/sheet_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/work_tag_edit_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/sheet_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/work_tag_edit_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!--
      提交中的进度条。MD3-E 用一条贴着分割线的 indeterminate 线表达「后台在做事」，
      而不是再叠一个转圈弹窗盖住整屏——用户提交时正看着自己那堆标签，不该被遮住。
      高度 0dp + 负 margin 让它压在分割线上，显隐不会让下面的内容跳一下。
    -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_inline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:trackCornerRadius="2dp"
        app:trackThickness="3dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 内容态：标签流。只有它滚动，输入条永远在外面。 -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_tags"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/tag_flow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:alignItems="flex_start"
                    app:flexWrap="wrap" />

                <!-- 一个标签都没有的作品：不留一片空白，明说 -->
                <TextView
                    android:id="@+id/empty_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="24dp"
                    android:text="@string/work_tag_edit_empty"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!--
          非内容态：加载中 / 读取失败 / 作者没开放编辑 / 网页登录失效。
          这几种以前各自是一个 QMUI 弹窗，现在收进同一张 sheet 里——它们说的都是
          「这张 sheet 现在给不了你标签」，没有一个值得再叠一层浮层。
        -->
        <LinearLayout
            android:id="@+id/state_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="12dp">

            <ceui.lisa.view.SeamlessCircularProgressIndicator
                android:id="@+id/state_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:indeterminate="true"
                app:indicatorSize="36dp"
                app:trackThickness="3dp" />

            <TextView
                android:id="@+id/state_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/state_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:visibility="gone"
                app:cornerRadius="100dp" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/divider_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!--
      底部动作条。两副面孔切换，而不是弹二级对话框：
      - 常态 input_bar：文本域 + filled「添加」；
      - 删除确认 confirm_bar：问一句 + 取消 / 删除。
      删除是要发网络、且别人加的标签删了就回不来，值得一次确认；但为此再叠一个居中弹窗
      会把用户正在看的标签整个盖住。就地换一条动作条，上下文一直在眼前。
    -->
    <FrameLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/input_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/work_tag_edit_input_hint"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:counterEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="@string/work_tag_edit_add"
                app:cornerRadius="100dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/confirm_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/confirm_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                app:cornerRadius="100dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_delete"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/action_delete"
                app:cornerRadius="100dp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
