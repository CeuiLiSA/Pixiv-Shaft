<?xml version="1.0" encoding="utf-8"?>
<!--
  toolbar + tabs + pager 的榜单布局。原为年代榜而建;年代榜后来改成「选择条 + bottom
  sheet」(fragment_rank_picker.xml,和标签专区一起),现在给壁纸榜(WallpaperRankFragment,
  手机/桌面两个固定 tab)和 TypeTabsRankFragment 一族(类型 / window / length 等 2–3 个固定
  tab)共用 —— 文件名和 years_loading 这个 id 是历史遗留,这些页面用不到 loading(tab 本地
  写死),直接 GONE。
  基于 fragment_recent_recommend.xml,只多一个居中 ProgressBar(异步拉 tab 列表的页面用,
  拉到之前没有 tab 可建)。tab 与那边同为 fixed + fill:当年为 20 个年份 tab 设的
  scrollable 会让 2–3 个 tab 挤在左边,与追更列表等页面的 tab 样式不一致。
  同样不复用 viewpager_with_tablayout.xml:那个被多处引用,不能为单一页面加控件。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <ceui.pixiv.widgets.TopInsetLinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/colorPrimary">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/app_bar"
                android:background="?attr/colorPrimary">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:theme="@style/AppTheme.AppBarOverlay"
                    app:popupTheme="@style/AppTheme.PopupOverlay"
                    android:layout_height="?attr/actionBarSize"
                    android:elevation="@dimen/six_dp"
                    app:layout_scrollFlags="scroll|enterAlways"
                    app:navigationIcon="@drawable/ic_arrow_back_white_shadow"
                    app:title=" "
                    app:titleTextColor="@android:color/white">

                    <TextView
                        android:id="@+id/toolbar_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                </androidx.appcompat.widget.Toolbar>

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_layout"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:background="?attr/colorPrimary"
                    app:tabIndicatorColor="@android:color/white"
                    app:tabIndicatorFullWidth="false"
                    app:tabMode="fixed"
                    app:tabGravity="fill"
                    app:tabSelectedTextColor="@android:color/white"
                    app:tabTextColor="@color/light_new_primary_color" />

            </com.google.android.material.appbar.AppBarLayout>

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/colorBackground"
                app:layout_behavior="@string/appbar_scrolling_view_behavior" />

            <!-- 拉 /discover/years 期间;拿到年份建完 tab 就 GONE。 -->
            <ProgressBar
                android:id="@+id/years_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

        </androidx.coordinatorlayout.widget.CoordinatorLayout>

    </ceui.pixiv.widgets.TopInsetLinearLayout>
</layout>
