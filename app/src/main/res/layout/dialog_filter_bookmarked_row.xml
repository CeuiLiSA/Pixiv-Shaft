<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data/>

    <!-- 对齐「预测性返回」弹窗的行：无底色、minHeight 52dp、标题左、开关右。 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp">

        <TextView
            android:id="@+id/fb_row_title"
            style="@style/M3SetTitle"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="72dp" />

        <!-- 同一面板里多行复用本布局，行内 @id/fb_row_switch 会重复。视图树 saved state 按 id
             拍平进同一个 SparseArray，同 id 后写覆盖先写，恢复时每行都拿到最后一行的值，又回调
             OnCheckedChangeListener 把设置写坏(#1117)。面板每次打开都按存储重新 bind，不需要恢复。 -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/fb_row_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:saveEnabled="false" />
    </RelativeLayout>
</layout>
