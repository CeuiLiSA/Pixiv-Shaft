<?xml version="1.0" encoding="utf-8"?>
<!--
  小说详情「作者」区块：标题 20sp Bold → 作者行（44dp 头像 + 1.5dp 主题色描边，名字 16sp SemiBold
  v3_text_1，@账号 12sp Medium v3_text_2）+ 关注胶囊（与用户卡同一套：48dp 热区里画 36dp 可见胶囊，
  未关注主题实色、已关注浅色「已关注 / 悄悄关注中」，见 FollowPill.kt）。下面接「其他作品」子行。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/author_title"
        style="@style/NovelDetailSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/novel_section_author" />

    <LinearLayout
        android:id="@+id/author_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/author_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no"
            app:civ_border_width="1.5dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/author_name"
                style="@style/textMontserratSemiBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/v3_text_1"
                android:textSize="16sp"
                tools:text="そっとじ@10/11" />

            <TextView
                android:id="@+id/author_account"
                style="@style/textMontserratMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/v3_text_2"
                android:textSize="12sp"
                tools:text="\@user_nxeu8357" />
        </LinearLayout>

        <TextView
            android:id="@+id/follow"
            style="@style/textMontserratSemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="76dp"
            android:minHeight="48dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textSize="14sp"
            tools:text="已关注" />
    </LinearLayout>
</LinearLayout>
