<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="ceui.pixiv.ui.prime.CorpusTagItemHolder" />
        <import type="android.view.View" />

        <variable
            name="holder"
            type="CorpusTagItemHolder" />

        <variable
            name="user"
            type="androidx.lifecycle.LiveData&lt;ceui.loxia.User>" />
    </data>

    <!-- 「热门搜索」的标签目录卡:标签名 + 作品数 + 三张预览方图。
         和 cell_item_prime_tag 有意保持同一套版式(用户看到的是同一种货架),
         区别只在副标题:那边是标签原名,这边是这个标签背后攒了多少件。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/cell_background"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tag_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@{holder.tag.name}"
            android:textColor="@color/text00"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tag_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{holder.countText}"
            android:textColor="@color/text20"
            android:textSize="15sp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/illusts_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="@{holder.tag.preview.size() > 0 ? View.VISIBLE : View.GONE}">

            <net.csdn.roundview.RoundImageView
                android:id="@+id/illust_1"
                android:background="@drawable/bg_tag_preview_placeholder"
                loadSquareMedia="@{holder.illust0}"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:rRadius="2dp" />

            <net.csdn.roundview.RoundImageView
                android:id="@+id/illust_2"
                android:background="@drawable/bg_tag_preview_placeholder"
                loadSquareMedia="@{holder.illust1}"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="2dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toStartOf="@+id/illust_3"
                app:layout_constraintStart_toEndOf="@+id/illust_1"
                app:layout_constraintTop_toTopOf="parent"
                app:rRadius="2dp" />

            <net.csdn.roundview.RoundImageView
                android:id="@+id/illust_3"
                android:background="@drawable/bg_tag_preview_placeholder"
                loadSquareMedia="@{holder.illust2}"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/illust_2"
                app:layout_constraintTop_toTopOf="parent"
                app:rRadius="2dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</layout>
