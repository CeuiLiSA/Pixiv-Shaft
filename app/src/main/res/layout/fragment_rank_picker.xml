<?xml version="1.0" encoding="utf-8"?>
<!--
  「选择条 + bottom sheet」式榜单宿主布局,标签专区(TagRankFragment)/年代榜
  (YearRankFragment)共用。基于 fragment_year_rank.xml,但 tab 条换成「当前选项」
  选择条:标签 top-50 / 年份 20 个塞进 TabLayout 的横滑都挑不动(用户反馈),
  点选择条弹 RankPickerSheet(bottom sheet 列表)选完整页展示。ViewPager 随之
  退场 —— 一次只看一个选项,child fragment 直接 replace 进 feed_container。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <ceui.pixiv.widgets.TopInsetLinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/colorPrimary">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/app_bar"
                android:background="?attr/colorPrimary">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:theme="@style/AppTheme.AppBarOverlay"
                    app:popupTheme="@style/AppTheme.PopupOverlay"
                    android:layout_height="?attr/actionBarSize"
                    android:elevation="@dimen/six_dp"
                    app:layout_scrollFlags="scroll|enterAlways"
                    app:navigationIcon="@drawable/ic_arrow_back_white_shadow"
                    app:title=" "
                    app:titleTextColor="@android:color/white">

                    <TextView
                        android:id="@+id/toolbar_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                </androidx.appcompat.widget.Toolbar>

                <!-- 当前选项 + 下拉箭头:点了弹 RankPickerSheet。tab 位同 fragment_year_rank
                     的 TabLayout,视觉延续「toolbar 下面一条选择器」的既有语言。 -->
                <TextView
                    android:id="@+id/rank_selector"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="?attr/colorPrimary"
                    android:clickable="true"
                    android:focusable="true"
                    android:drawableEnd="@drawable/ic_baseline_keyboard_arrow_down_24"
                    android:drawablePadding="4dp"
                    android:drawableTint="@android:color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:paddingStart="@dimen/twelve_dp"
                    android:paddingEnd="@dimen/twelve_dp"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </com.google.android.material.appbar.AppBarLayout>

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/feed_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/colorBackground"
                app:layout_behavior="@string/appbar_scrolling_view_behavior" />

            <!-- 拉选项列表(/discover/tags 或 /discover/years)期间;装上首个 feed 就 GONE。 -->
            <ProgressBar
                android:id="@+id/rank_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

        </androidx.coordinatorlayout.widget.CoordinatorLayout>

    </ceui.pixiv.widgets.TopInsetLinearLayout>
</layout>
