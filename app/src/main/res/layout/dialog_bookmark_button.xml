<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data/>

    <!-- 与「预测性返回」「过滤已收藏」弹窗同一套内边距与结构：24dp 横向、10dp 顶、12dp 底，
         顶部一行 13sp 说明文字，下面两个分组标题 + 各自的开关行容器。
         分组标题照 dialog_predictive_back.xml：12sp / v3_text_3。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bookmark_button_dialog_hint"
            android:textColor="@color/v3_text_2"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/bookmark_button_group_common"
            android:textColor="@color/v3_text_3"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/bb_common_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- 分组标题也要 id：「更多」那 12 行是弹窗第一帧画完之后才补的，补上之前先把这个标题藏起来，
             否则会出现一个底下没有内容的空标题。 -->
        <TextView
            android:id="@+id/bb_more_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/bookmark_button_group_more"
            android:textColor="@color/v3_text_3"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/bb_more_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</layout>