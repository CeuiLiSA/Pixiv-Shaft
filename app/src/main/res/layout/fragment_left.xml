<?xml version="1.0" encoding="utf-8"?>
<ceui.pixiv.witstudio.widget.WitLiquidGlassCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/glass_host"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v3_bg">

    <!-- Child 0: 首页推荐内容页（液态玻璃模式下取消 appbar_scrolling_view_behavior，全屏铺至屏幕顶侵入顶栏与状态栏） -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Child 1: iOS 26 UIScrollEdgeEffect.Style.soft 轻量紧凑顶部渐进模糊层（仅覆盖状态栏与可见 Toolbar） -->
    <ceui.pixiv.witstudio.widget.WitScrollEdgeBlurView
        android:id="@+id/top_scroll_edge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:alpha="0"
        android:visibility="gone"
        app:wit_edgeFeatherHeight="18dp"
        app:wit_edgeOpaqueHeaderFallback="true"
        app:wit_edgeScrimColor="@color/v3_bg" />

    <!-- Child 2: 宽窗口（侧边导航栏在显示，#1087）V3 页头：与「发现」「动态」同款悬浮标题行 + 分段切换 -->
    <LinearLayout
        android:id="@+id/wide_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:letterSpacing="-0.02"
                android:text="@string/recommend"
                android:textColor="@color/v3_text_1"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/wide_search"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search"
                android:scaleType="centerInside"
                android:src="@drawable/ic_search_black_24dp"
                app:tint="@color/v3_text_1" />

        </LinearLayout>

        <!-- 外层 FrameLayout 给分段控件兜宽度上限，理由同 fragment_new_right 的 dynamic_type_toggle -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp">

            <ceui.lisa.view.SegmentedToggleLayout
                android:id="@+id/wide_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:stl_textSize="16sp" />

        </FrameLayout>

    </LinearLayout>

    <!-- Child 3: 手机排版 AppBarLayout（marginTop = statusBarHeight，收起 Toolbar 时由 clipBounds 精确裁在状态栏底缘） -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="?attr/colorPrimary"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:layout_scrollFlags="scroll|enterAlways"
            app:navigationIcon="@drawable/ic_baseline_dns_24"
            app:titleTextColor="@android:color/white">

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:textSize="18sp" />

        </androidx.appcompat.widget.Toolbar>

        <!-- 透明占位，锁定 AppBarLayout 总高度（Toolbar + TabBar）以供经典模式 ScrollingViewBehavior 与列表顶留白计算 -->
        <View
            android:id="@+id/tab_spacer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:color/transparent" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Child 4: 与首页底栏同款的 iOS 26 液态玻璃交互 Tab 胶囊（标准/极致模式复用 WitLiquidGlassTabBar 完整按压缩放/水滴透镜/拖拽/滑动动效；经典模式退回实底 TabLayout） -->
    <ceui.pixiv.witstudio.widget.WitLiquidGlassView
        android:id="@+id/tab_glass_platter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            app:tabGravity="fill"
            app:tabIndicatorColor="@android:color/white"
            app:tabIndicatorFullWidth="false"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@android:color/white"
            app:tabTextColor="@color/light_new_primary_color" />

    </ceui.pixiv.witstudio.widget.WitLiquidGlassView>

    <!-- Child 5: 经典模式状态栏底色条（放在 app_bar 之上遮住上滑收起的 Toolbar；液态玻璃态透明） -->
    <ImageView
        android:id="@+id/head"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="top"
        android:background="?attr/colorPrimary"
        android:importantForAccessibility="no" />

</ceui.pixiv.witstudio.widget.WitLiquidGlassCoordinatorLayout>
