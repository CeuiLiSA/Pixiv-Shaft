<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v3_bg"
    android:orientation="vertical">

    <include layout="@layout/toolbar_layout" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/discovery_modes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_margin="8dp"
        android:background="@drawable/bg_reader_segment_track"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabMinWidth="96dp"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorGravity="stretch"
        app:tabTextAppearance="@style/WebDiscoveryTabText"
        app:tabTextColor="@color/v3_text_2"
        app:tabSelectedTextColor="@color/v3_text_1" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/discovery_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
