<?xml version="1.0" encoding="utf-8"?>
<!-- pixiv COMIC 官方连载作品(首页「更新された作品」宫格,3 列)。
     封面走 main_image_url —— 服务端给的 thumbnail_image_url 18 个里有 17 个是 404,
     不能拿它当主图(见 ComicTopFeed 里的 coverUrlOf)。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="6dp"
    android:paddingVertical="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/cover_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintDimensionRatio="H,3:4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/v3_surface_2"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/badge_new"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@drawable/v3_novel_word_count_bg"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/comic_badge_new"
            android:textColor="?attr/colorPrimary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/cover_card"
            app:layout_constraintTop_toTopOf="@id/cover_card"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="2"
        android:textColor="@color/v3_text_1"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="福引で当たったので異世界に移住し、恋をしました" />

    <TextView
        android:id="@+id/author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/v3_text_3"
        android:textSize="11sp"
        tools:text="日野晶,原作：花柄" />

    <TextView
        android:id="@+id/stories_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/v3_text_2"
        android:textSize="11sp"
        tools:text="全11話" />
</LinearLayout>
