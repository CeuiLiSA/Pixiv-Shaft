<?xml version="1.0" encoding="utf-8"?>
<!-- 搜索首页「置顶作者」那一排的格子。样式跟隔壁置顶标签的
     recy_single_line_text_with_delete 对齐（同一个 normal_bg + 8dp 内距），
     只是把固定图标换成作者头像。 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/four_dp"
        android:background="@drawable/normal_bg"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:padding="@dimen/eight_dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/user_avatar"
            android:layout_width="@dimen/twenty_four_dp"
            android:layout_height="@dimen/twenty_four_dp"
            android:layout_marginEnd="@dimen/eight_dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="160dp"
            android:textColor="@color/second_text_color"
            android:textSize="13sp" />

    </LinearLayout>

    <data>

    </data>

</layout>
