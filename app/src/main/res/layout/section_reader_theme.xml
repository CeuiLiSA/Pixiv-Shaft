<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/M3SetHeader"
            android:text="@string/reader_section_theme" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_reader_group_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <include
                android:id="@+id/row_theme_picker"
                layout="@layout/item_reader_setting_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View style="@style/ReaderRowDivider" />

            <LinearLayout
                android:id="@+id/row_text_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    style="@style/textMontserratMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_text_color"
                    android:textColor="@color/v3_text_1"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/text_color_value"
                    style="@style/textMontserratRegular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/v3_text_2"
                    android:textSize="14sp" />

                <TextView
                    style="@style/textMontserratRegular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/setting_text_color_hint"
                    android:textColor="@color/v3_text_2"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/row_reset_text_color"
                style="@style/textMontserratMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/setting_text_color_reset"
                android:textColor="@color/v3_text_1"
                android:textSize="14sp"
                android:visibility="gone" />

            <View style="@style/ReaderRowDivider" />

            <include
                android:id="@+id/row_follow_system_dark"
                layout="@layout/item_reader_setting_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View style="@style/ReaderRowDivider" />

            <include
                android:id="@+id/row_use_system_brightness"
                layout="@layout/item_reader_setting_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View style="@style/ReaderRowDivider" />

            <include
                android:id="@+id/row_custom_brightness"
                layout="@layout/item_reader_setting_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View style="@style/ReaderRowDivider" />

            <include
                android:id="@+id/row_warm_filter"
                layout="@layout/item_reader_setting_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</layout>
