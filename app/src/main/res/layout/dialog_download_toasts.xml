<?xml version="1.0" encoding="utf-8"?>
<!--
  「下载相关提示消息」弹窗内容（DownloadToastDialog）：顶部一行 13sp 说明，下面按
  「图片下载 / 小说下载」两组铺通用开关行（witstudio 的 wit_dialog_switch_row）。

  版式对齐「预测性返回」弹窗：24dp 横向内边距、10dp 顶、12dp 底，分组标题 12sp v3_text_3。
  比「过滤已收藏」多这层分组标题，是因为这里有 15 行，平铺会糊成一片。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/download_toast_dialog_hint"
        android:textColor="@color/v3_text_2"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/download_toast_group_image"
        android:textColor="@color/v3_text_3"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/dt_image_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/download_toast_group_novel"
        android:textColor="@color/v3_text_3"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/dt_novel_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>