<?xml version="1.0" encoding="utf-8"?>
<!-- V3 single-choice 行：标签左，选中时右侧 ✓ —— SimplePickerSheet / DurationPickerSheet
     的相对时间段 / OtherFilterSheet 的 R-18 三选一 都用这个。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">

    <TextView
        android:id="@+id/check_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingTop="14dp"
        android:paddingEnd="10dp"
        android:paddingBottom="14dp"
        android:textColor="@color/v3_text_1"
        android:textSize="15sp"
        tools:text="标签部分匹配" />

    <!-- 「其他条件」的临时态提示：勾选值 ≠ 全局设置值时，显示在勾的左侧。
         默认 gone —— 本布局被 SimplePickerSheet / R-18 行共用，它们不显示这枚提示。
         文字色与勾同走主题色，在代码里 setTextColor(palette.textAccent)（同 check_mark）。 -->
    <TextView
        android:id="@+id/check_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="临时的（长按记住）"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/check_mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingBottom="2dp"
        android:text="✓"
        android:textSize="20sp"
        android:visibility="invisible"
        tools:visibility="visible" />

</LinearLayout>
