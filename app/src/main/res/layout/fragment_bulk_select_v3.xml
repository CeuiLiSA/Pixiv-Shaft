<?xml version="1.0" encoding="utf-8"?>
<!--
  批量选择页。toolbar 右上挂 menu_bulk_select_v3（全选 / 导出链接），
  底部是 MD3-E connected button group：下载 CTA + 收藏动作。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v3_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/v3_bg"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/v3_bg"
            app:contentInsetStartWithNavigation="0dp"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/bulk_select_title"
            app:titleTextAppearance="@style/TextAppearance.AppCompat.Title"
            app:titleTextColor="@color/v3_text_1" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingHorizontal="16dp"
            android:paddingBottom="10dp"
            android:textColor="@color/v3_text_3"
            android:textSize="11sp"
            tools:text="共 32 项 · 已选 32 项 (GIF 自动跳过)" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="80dp"
        tools:listitem="@layout/cell_bulk_select_v3" />

    <!--
      底部操作 bar：全选 / 导出 在 toolbar 右上，这里是 MD3-E connected button group。

      首段 = 下载 CTA（filled，主操作，语义和改版前完全一致）；
      尾段 = 收藏动作（tonal，点开 V3 菜单选批量收藏 / 批量取消收藏）。
      两段之间只留 3dp 缝、相邻的圆角收成 8dp，读起来是一组而不是两个按钮；
      按压时形状收成 12dp（见 bg_bulk_action_*）。

      收藏动作走菜单而不是再摊平成第三段：段宽越分越窄，而
      「取消收藏」这类词在 ru / tr 下长得多，摊平一定会截断；菜单行没有宽度约束。
    -->
    <!--
      margin / padding 一律用 Start/End 而不是 Horizontal：后者是 API 26 才有的属性，
      本模块 minSdk 24，在 24/25 上会被静默忽略（不报错，只是没有间距），
      底栏会直接贴着屏幕两边。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnConfirm"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_bulk_action_primary"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textAllCaps="false"
            android:textColor="@color/bulk_action_primary_text"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="加入下载队列 (32 项 / 87 张)" />

        <Space
            android:layout_width="3dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/btnBookmarkActions"
            android:layout_width="76dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_bulk_action_trailing"
            android:clickable="true"
            android:contentDescription="@string/bulk_bookmark_actions"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_like_heart_fill"
                app:tint="@color/v3_blue" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_drop_down_20dp"
                app:tint="@color/v3_blue" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
