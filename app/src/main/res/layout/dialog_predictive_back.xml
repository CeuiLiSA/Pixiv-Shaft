<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/setting_predictive_back_dialog_hint"
            android:textColor="@color/v3_text_2"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/pb_help"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/setting_predictive_back_help"
            android:focusable="true"
            android:src="@drawable/ic_help_outline_black_24dp"
            app:tint="@color/v3_text_3" />
    </LinearLayout>

    <TextView
        android:id="@+id/pb_help_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/setting_predictive_back_desc"
        android:textColor="@color/v3_text_3"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/setting_predictive_back_group_system"
        android:textColor="@color/v3_text_3"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/pb_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/setting_predictive_back_group_drawer"
        android:textColor="@color/v3_text_3"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/pb_drawer_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/setting_predictive_back_group_experimental"
        android:textColor="@color/v3_text_3"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/pb_experimental_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>