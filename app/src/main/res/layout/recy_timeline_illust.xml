<?xml version="1.0" encoding="utf-8"?>
<!--
  「动态」时间线大卡（V3「作品 / 内容」配方，同广场帖子列表的无界平铺）：
  - 本列表坐在动态页那张 cardFill 圆角 sheet 里，条目**不套卡底、不画自己的底色**（画 v3_bg 会在
    筛选条下方裂出撞色横缝），左右 16dp、上下 14dp，条目间是列表的通栏 hairline
    （FollowingIllustFeedFragment 给的 BottomDividerDecoration），按下是矩形涟漪。
  - 头部：40dp 头像 + 1.5dp 主题色描边（同用户卡 / 画师主页）→ 名字 15sp Montserrat SemiBold v3_text_1、
    时间 12sp Montserrat Medium v3_text_2（v3_text_3 只有 33% alpha，不承载信息）。
  - 标题 16sp SemiBold v3_text_1（卡片标题），最多两行；图区 16dp 圆角，统计 / 页数是图上的玻璃小标。
  尺寸改动要同步 TimelineIllustCard 的 CARD_HORIZONTAL_PADDING_DP 与 FeedTimelineSkeletonView。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- ═══ Header: avatar + name + time ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/user_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:civ_border_color="?attr/colorPrimary"
            app:civ_border_width="1.5dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/user_name"
                style="@style/textMontserratSemiBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/v3_text_1"
                android:textSize="15sp"
                tools:text="はむねずこ" />

            <TextView
                android:id="@+id/post_time"
                style="@style/textMontserratMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/v3_text_2"
                android:textSize="12sp"
                tools:text="1 天前" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ Title ═══ -->
    <TextView
        android:id="@+id/title"
        style="@style/textMontserratSemiBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/v3_text_1"
        android:textSize="16sp"
        tools:text="【ラブカ】WATER BLUE NEW WORLD" />

    <!-- ═══ Image area: 16dp rounded container + glass overlays ═══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/v3_surface_2"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Main image -->
            <ImageView
                android:id="@+id/illust_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <!-- Multi-image grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/image_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone" />

            <!-- Stats pill (bottom-start): 自带足够不透明的玻璃底，不再给整张图压一道底部渐变 -->
            <LinearLayout
                android:id="@+id/stats_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:background="@drawable/bg_stats_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_baseline_remove_red_eye_24"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/view_count"
                    style="@style/textMontserratSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    tools:text="2,846" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_baseline_bookmark_24"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/bookmark_count"
                    style="@style/textMontserratSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    tools:text="950" />
            </LinearLayout>

            <!-- Page count badge (top-end) -->
            <LinearLayout
                android:id="@+id/page_count_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:background="@drawable/bg_stats_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_baseline_grid_view_24"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/page_count"
                    style="@style/textMontserratSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    tools:text="3" />
            </LinearLayout>

        </FrameLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
