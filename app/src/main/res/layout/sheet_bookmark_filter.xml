<?xml version="1.0" encoding="utf-8"?>
<!--
  本地库（收藏 / 关注）「筛选与排序」bottom sheet 壳。V3 + MD3-E（docs/v3-design-philosophy.md）。

  只放骨架：把手 → 标题行（标题 + 当前状态 + 清空）→ 可滚动的分组卡片 → 底部主操作。
  一组一组的筛选项由 BookmarkFilterSheet 按书架的 LibraryProfile 用 LibraryFilterViews
  声明式生成 —— 维度有十几个，写成 XML 是十几段几乎一样的复制粘贴。

  顺序照规范的 Sheet 配方：标题 → 当前状态 → 条件 → 主操作。表面是 v3_bg + 顶角 28dp，
  条件装在 22dp 的 cardFill 分组卡里，主操作是整宽实色胶囊，文案永远带实时命中数。

  ⚠️ **根上刻意不套 `Theme.Material3.DayNight.NoActionBar`**。那是一个**完整 theme**
  （不是 ThemeOverlay），套上去会把 app 自己的 `colorPrimary` 整个换成 M3 的默认紫 ——
  本 sheet 里所有从 V3Palette 派生的颜色就不再跟随用户选的主题色。把手因此自绘。
  dialog 自身的 theme（getTheme()）是 ThemeOverlay，overlay 只叠不换，colorPrimary 照常继承。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_m3e_sheet_top"
    android:clipToOutline="true"
    android:orientation="vertical">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_sheet_drag_handle"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sheet_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:text="@string/bookmark_library_filter_title"
                android:textColor="@color/v3_text_1"
                android:textSize="22sp" />

            <!-- 当前状态：书架总数 · 开了几项筛选。命中数在底部主操作上，这里不重复。 -->
            <TextView
                android:id="@+id/summary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/montserrat_medium"
                android:textColor="@color/v3_text_2"
                android:textSize="13sp"
                tools:text="共 3,210 件 · 已启用 2 项筛选" />
        </LinearLayout>

        <!-- 「清空」放在标题行末端而不是底部：它是撤销，跟底部的确认是相反意图，挨在一起最容易误触。
             样式（浅色胶囊、48dp 热区、无条件时置灰）由代码按 V3Palette 设置。 -->
        <TextView
            android:id="@+id/reset_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/bookmark_library_filter_reset" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sections_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdgeLength="16dp"
        android:requiresFadingEdge="vertical">

        <LinearLayout
            android:id="@+id/sections_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp" />
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/v3_border_1" />

    <!-- 主操作：整宽实色胶囊。文案永远带**实时命中数**——上面每点一下这个数就变一次，
         不用关掉 sheet 才知道自己筛出了什么。背景 / 字色 / 按压由代码按 V3Palette 设置。 -->
    <TextView
        android:id="@+id/apply_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        tools:text="查看 1,204 件" />
</LinearLayout>
