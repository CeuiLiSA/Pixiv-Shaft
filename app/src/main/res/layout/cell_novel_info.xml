<?xml version="1.0" encoding="utf-8"?>
<!--
  小说详情「信息」区块（取代旧「作品档案」chip 墙）：标题行可折叠（默认折叠跟设置
  isDetailPanelCollapsedByDefault 走），下面是一张两列信息表，每行至少 48dp。
  标签 14sp Regular v3_text_2，值 14sp Medium v3_text_1（等宽数字），动作 14sp SemiBold
  textAccent；行间细线 cardHairline（代码注入）。标题行的 48dp 已含 12dp 上留白，故 paddingTop 12dp。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:id="@+id/info_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/info_title"
            style="@style/NovelDetailSectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/novel_section_info" />

        <ImageView
            android:id="@+id/info_arrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_keyboard_arrow_up_black_24dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/info_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/row_published"
            style="@style/NovelDetailInfoRow"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                style="@style/NovelDetailInfoLabel"
                android:text="@string/v3_detail_published" />

            <TextView
                android:id="@+id/value_published"
                style="@style/NovelDetailInfoValue"
                tools:text="2026-10-26 00:18" />
        </LinearLayout>

        <View
            android:id="@+id/line_1"
            style="@style/NovelDetailInfoLine" />

        <LinearLayout
            android:id="@+id/row_novel_id"
            style="@style/NovelDetailInfoRow"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                style="@style/NovelDetailInfoLabel"
                android:text="@string/v3_detail_artwork_id" />

            <TextView
                android:id="@+id/value_novel_id"
                style="@style/NovelDetailInfoValue"
                tools:text="29473168" />

            <ImageView
                android:id="@+id/copy_novel_id"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/baseline_content_copy_24" />
        </LinearLayout>

        <View
            android:id="@+id/line_2"
            style="@style/NovelDetailInfoLine" />

        <LinearLayout
            android:id="@+id/row_user_id"
            style="@style/NovelDetailInfoRow"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                style="@style/NovelDetailInfoLabel"
                android:text="@string/novel_info_user_id" />

            <TextView
                android:id="@+id/value_user_id"
                style="@style/NovelDetailInfoValue"
                tools:text="34234422" />

            <ImageView
                android:id="@+id/copy_user_id"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/baseline_content_copy_24" />
        </LinearLayout>

        <View
            android:id="@+id/line_3"
            style="@style/NovelDetailInfoLine" />

        <!-- 链接行：本身不可点，右侧两个 48dp 文字按钮；动作行上下不再加 padding，按钮自带热区。 -->
        <LinearLayout
            android:id="@+id/row_novel_link"
            style="@style/NovelDetailInfoRow"
            android:paddingTop="0dp"
            android:paddingBottom="0dp">

            <TextView
                style="@style/NovelDetailInfoLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/novel_chip_novel_link" />

            <TextView
                android:id="@+id/novel_link_copy"
                style="@style/NovelDetailInfoAction"
                android:text="@string/action_copy" />

            <TextView
                android:id="@+id/novel_link_open"
                style="@style/NovelDetailInfoAction"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="-8dp"
                android:text="@string/action_open" />
        </LinearLayout>

        <View
            android:id="@+id/line_4"
            style="@style/NovelDetailInfoLine" />

        <LinearLayout
            android:id="@+id/row_user_link"
            style="@style/NovelDetailInfoRow"
            android:paddingTop="0dp"
            android:paddingBottom="0dp">

            <TextView
                style="@style/NovelDetailInfoLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/novel_info_user_link" />

            <TextView
                android:id="@+id/user_link_copy"
                style="@style/NovelDetailInfoAction"
                android:text="@string/action_copy" />

            <TextView
                android:id="@+id/user_link_open"
                style="@style/NovelDetailInfoAction"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="-8dp"
                android:text="@string/action_open" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
