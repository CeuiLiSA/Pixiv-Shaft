<?xml version="1.0" encoding="utf-8"?>
<!--
  「我置顶的内容 → 作者」列表 cell（V3 设计哲学）：
  22dp cardSurface（运行时由 V3Palette 派生卡底与 hairline）+
  44dp 圆形头像（运行时套 1.5dp 主题色描边，对齐 V3 用户卡与画师主页）+
  昵称 16sp SemiBold / v3_text_1 → @账号 · UID 13sp / v3_text_2 + 末端 48dp 取消置顶热区。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:paddingStart="16dp"
    android:paddingEnd="6dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/user_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@color/v3_surface_2"
        android:contentDescription="@null"
        android:padding="1.5dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Chat.Avatar"
        app:strokeWidth="1.5dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/user_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/v3_text_1"
            android:textSize="16sp"
            tools:text="藤ちょこ（藤原）" />

        <TextView
            android:id="@+id/user_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/v3_text_2"
            android:textSize="13sp"
            tools:text="\@fuzichoco · ID 27517" />

    </LinearLayout>

    <ImageView
        android:id="@+id/delete_pin"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/unpin_user"
        android:padding="13dp"
        android:src="@drawable/ic_close_black_24dp"
        app:tint="@color/v3_text_2" />

</LinearLayout>
