<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/spark_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/v3_bg" android:paddingStart="20dp" android:paddingEnd="20dp">
 <ScrollView android:id="@+id/spark_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:paddingTop="20dp" android:paddingBottom="16dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
     <TextView android:id="@+id/spark_eyebrow" style="@style/SparkText.Label" android:text="SPARK / LAB" android:letterSpacing="0.16" android:textColor="@color/v3_text_1"/>
     <TextView android:id="@+id/spark_title" style="@style/SparkText.Heading" android:text="Spark AI 实验室" android:textSize="30sp" android:layout_marginTop="6dp"/>
     <TextView android:id="@+id/spark_subtitle" style="@style/SparkText" android:text="对话、翻译，在一个工作台完成。" android:textColor="@color/v3_text_2" android:layout_marginTop="5dp"/>
    </LinearLayout>
   </LinearLayout>
   <LinearLayout android:id="@+id/spark_mode_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="4dp" android:layout_marginTop="20dp" android:background="@drawable/bg_v3_surface">
    <Button android:id="@+id/spark_tab_chat" style="@style/SparkButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="对话" android:contentDescription="@string/spark_lab_chat"/>
    <Button android:id="@+id/spark_tab_translate" style="@style/SparkButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="翻译" android:contentDescription="@string/spark_lab_translate" android:layout_marginStart="4dp"/>
   </LinearLayout>
   <LinearLayout android:id="@+id/spark_chat_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="28dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
     <TextView android:id="@+id/spark_chat_section_title" style="@style/SparkText.Heading" android:text="开始一段对话"/>
     <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
     <TextView android:id="@+id/spark_model_label" style="@style/SparkText.Label" android:text="gpt-5.3 · SPARK" android:textColor="@color/v3_text_2" android:contentDescription="@string/spark_lab_model"/>
     <Button android:id="@+id/spark_clear" style="@style/SparkButton" android:layout_width="wrap_content" android:layout_height="40dp" android:minHeight="40dp" android:text="清空" android:textSize="12sp" android:contentDescription="@string/spark_lab_reset" android:layout_marginStart="4dp" android:paddingStart="10dp" android:paddingEnd="10dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/spark_empty_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp" android:layout_marginTop="12dp" android:background="@drawable/bg_v3_surface">
     <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✦" android:textSize="32sp" android:textColor="@color/v3_text_1"/>
     <TextView android:id="@+id/spark_empty_title" style="@style/SparkText.Heading" android:text="从一个问题开始" android:layout_marginTop="7dp"/>
     <TextView android:id="@+id/spark_empty_body" style="@style/SparkText" android:text="整理想法、解释文本，或继续追问。回答会逐步显示。" android:gravity="center" android:textColor="@color/v3_text_2" android:layout_marginTop="4dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/spark_transcript" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" android:visibility="gone"/>
   </LinearLayout>
   <LinearLayout android:id="@+id/spark_translate_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="28dp" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
     <TextView style="@style/SparkText.Heading" android:text="翻译工作台"/>
     <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
     <Button android:id="@+id/spark_translate_clear" style="@style/SparkButton" android:layout_width="wrap_content" android:layout_height="40dp" android:minHeight="40dp" android:text="清空" android:textSize="12sp" android:contentDescription="@string/spark_lab_reset" android:paddingStart="10dp" android:paddingEnd="10dp"/>
    </LinearLayout>
    <TextView style="@style/SparkText" android:text="保留原文语气，逐段查看译文。" android:textColor="@color/v3_text_2" android:layout_marginTop="4dp"/>
    <TextView style="@style/SparkText.Label" android:text="原文" android:layout_marginTop="18dp"/>
    <EditText android:id="@+id/spark_source" style="@style/SparkInput" android:hint="粘贴需要翻译的文字…" android:minHeight="140dp" android:layout_marginTop="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
     <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
      <TextView style="@style/SparkText.Label" android:text="翻译为"/>
      <EditText android:id="@+id/spark_target" style="@style/SparkInput" android:hint="中文" android:singleLine="true" android:layout_marginTop="7dp"/>
     </LinearLayout>
     <Space android:layout_width="12dp" android:layout_height="1dp"/>
     <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
      <TextView style="@style/SparkText.Label" android:text="语气与要求"/>
      <EditText android:id="@+id/spark_prompt" style="@style/SparkInput" android:hint="可选" android:singleLine="true" android:layout_marginTop="7dp"/>
     </LinearLayout>
    </LinearLayout>
    <Button android:id="@+id/spark_translate_send" style="@style/SparkButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="开始翻译" android:layout_marginTop="14dp"/>
    <LinearLayout android:id="@+id/spark_translation_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="16dp" android:background="@drawable/bg_v3_surface">
     <TextView style="@style/SparkText.Label" android:text="译文" android:textColor="@color/v3_text_2"/>
     <TextView android:id="@+id/spark_translation_text" style="@style/SparkText" android:text="译文将显示在这里" android:textColor="@color/v3_text_2" android:layout_marginTop="8dp"/>
    </LinearLayout>
   </LinearLayout>
  </LinearLayout>
 </ScrollView>
 <LinearLayout android:id="@+id/spark_composer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:paddingTop="8dp" android:paddingBottom="10dp" android:background="@color/v3_bg">
  <EditText android:id="@+id/spark_input" style="@style/SparkInput" android:layout_width="0dp" android:layout_weight="1" android:minHeight="54dp" android:maxLines="5" android:hint="输入问题或粘贴文本…"/>
  <ImageButton android:id="@+id/spark_chat_send" style="@style/SparkIconButton" android:layout_width="54dp" android:layout_height="54dp" android:src="@drawable/chat_ic_send" android:layout_marginStart="8dp" android:contentDescription="@string/spark_lab_send"/>
 </LinearLayout>
</LinearLayout>
