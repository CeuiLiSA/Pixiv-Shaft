<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/v3_bg"
    app:cardCornerRadius="18dp"
    app:cardElevation="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/image_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!--
              高度靠 setHeightRatio 在 onMeasure 里按真实列宽算(对齐 recy_illust_stagger):
              宽度必须留给瀑布流列自己定,绝不在 bind 时写死像素——写死就锁在某一个列数/某一个
              屏幕方向上,换「每行几列」设置或横竖屏切换后复用的卡片会揣着旧尺寸把整列搞乱。
            -->
            <ceui.lisa.view.DynamicHeightImageView
                android:id="@+id/illust_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/v3_surface_2"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/p_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/v3_badge_pages_bg"
                android:includeFontPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="3P"
                tools:visibility="visible" />

            <!-- 右下角操作行：快照标记 + 删除钮。
                 快照标记只在「这件作品本地有离线快照」时出现，点开直接进离线详情页；
                 删除钮在选择态隐藏（见 HistorySelectBadge.bindSelection），快照标记跟着一起藏 ——
                 多选是「挑出来删」的态，不该留着别的可点控件。
                 8dp 外边距挂在这一行上，删除钮的位置与改造前逐像素一致。 -->
            <LinearLayout
                android:id="@+id/card_action_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 内边距 4dp 而不是删除钮的 6dp：这枚图标（相框 + 断网云 + 斜划线）细节比
                     垃圾桶多，30dp 底座里留 18dp 会糊成一团，22dp 才认得出来。底座仍是 30dp，
                     两个钮的外框一样大。 -->
                <ImageView
                    android:id="@+id/snapshot_button"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/v3_nav_btn_bg"
                    android:contentDescription="@string/snapshot_downloaded_label"
                    android:padding="4dp"
                    android:src="@drawable/ic_snapshot_24"
                    android:visibility="gone"
                    app:tint="#CCFFFFFF" />

                <ImageView
                    android:id="@+id/delete_item"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/v3_nav_btn_bg"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_delete_black_24dp"
                    app:tint="#CCFFFFFF" />
            </LinearLayout>

            <!-- 多选勾标:仅选择态显示(HistorySelectBadge 切实心/空心)。 -->
            <ImageView
                android:id="@+id/select_check"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:contentDescription="@null"
                android:padding="5dp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:textColor="@color/v3_text_1"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="作品标题" />

            <TextView
                android:id="@+id/author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/v3_text_3"
                android:textSize="11sp"
                tools:text="by: 作者" />

            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/v3_text_3"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:text="2 分钟前" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
