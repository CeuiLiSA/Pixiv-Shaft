<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/dialog_read_timeout_value"
        style="@style/textMontserratSemiBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textColor="?attr/colorPrimary"
        android:textSize="32sp" />

    <TextView
        android:id="@+id/dialog_read_timeout_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/setting_read_timeout_dialog_hint"
        android:textColor="@color/v3_text_2"
        android:textSize="13sp" />

    <SeekBar
        android:id="@+id/dialog_read_timeout_slider"
        style="@style/Widget.Reader.Slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/dialog_read_timeout_min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:textColor="@color/v3_text_3"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dialog_read_timeout_max"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:textColor="@color/v3_text_3"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- 滑条下面的选项开关：图片加载是否也容许一次断流超时并静默重试。默认关。 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp">

        <TextView
            android:id="@+id/dialog_read_timeout_stall_retry_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@id/dialog_read_timeout_stall_retry"
            android:text="@string/setting_read_timeout_stall_retry"
            android:textColor="@color/v3_text_1"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/dialog_read_timeout_stall_retry"
            style="@style/M3SetSwitch" />
    </RelativeLayout>
</LinearLayout>