<?xml version="1.0" encoding="utf-8"?>
<!-- feeds 框架版:纯 ViewBinding(无 <layout>/<data>),交互与主题强调色全部在
     ceui.pixiv.ui.comments.CommentsFragment 的 feedRenderer 里手绑。
     无界平铺(#1038 同款,和 recy_novel 一个口径):不套 CardView、条目 edge-to-edge,
     条目间距由自身上下 padding 承担;条目之间的 hairline 由 CommentsFragment.onListReady 的
     BottomDividerDecoration 画(不写在 cell 里 —— 插入/追加不会重绑相邻条目,写在 cell 里会漏画)。
     padding 四向拆开写 —— paddingHorizontal 是 API 26+ 属性,minSdk 24 的机器上会被静默忽略。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- ═══ Header: avatar · [作者] name · time ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/user_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="12dp"
            android:scaleType="centerCrop"
            app:civ_border_color="@color/v3_border_2"
            app:civ_border_width="2dp" />

        <TextView
            android:id="@+id/arthur_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="7dp"
            android:background="@drawable/v3_author_badge_bg"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:text="@string/string_432"
            android:textColor="@color/v3_purple"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="作者"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/user_name"
            style="@style/textMontserratSemiBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:textColor="@color/v3_text_1"
            android:textSize="15sp"
            tools:text="Pixiv 用户的名字很长很长" />

        <TextView
            android:id="@+id/comment_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:textColor="@color/v3_text_3"
            android:textSize="11sp"
            tools:text="3 小时前" />
    </LinearLayout>

    <!-- ═══ Body: text or stamp ═══ -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="54dp"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/comment_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.01"
            android:lineSpacingMultiplier="1.35"
            android:textColor="@color/v3_text_1"
            android:textSize="15sp"
            tools:text="这是一条评论内容，写得挺长的一段话用来测试换行和行距效果。" />

        <net.csdn.roundview.RoundImageView
            android:id="@+id/comment_stamp"
            android:layout_width="96dp"
            android:layout_height="96dp"
            app:rRadius="18dp" />
    </FrameLayout>

    <!-- ═══ Translation: hairline + 译文 ═══
         默认 gone;译文住在 CommentFeedItem.translations,由 bindCommentTranslation 绑定、
         刚译完那一次做高度展开动画(见 CommentTranslationReveal.kt)。 -->
    <LinearLayout
        android:id="@+id/translation_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="54dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline_width"
            android:layout_marginTop="8dp"
            android:background="@drawable/hairline_divider" />

        <TextView
            android:id="@+id/translation_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.01"
            android:lineSpacingMultiplier="1.35"
            android:textColor="@color/v3_text_2"
            android:textSize="15sp"
            tools:text="这是翻译后的评论内容。" />
    </LinearLayout>

    <!-- ═══ Actions ═══ -->
    <LinearLayout
        android:id="@+id/action_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="54dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/v3_action_pill_bg"
            android:drawablePadding="5dp"
            android:paddingStart="11dp"
            android:paddingTop="7dp"
            android:paddingEnd="13dp"
            android:paddingBottom="7dp"
            android:text="@string/string_176"
            android:textColor="@color/v3_text_2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ceui.pixiv.widgets.ProgressTextButton
            android:id="@+id/show_reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/v3_action_pill_bg"
            android:drawablePadding="3dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="11dp"
            android:paddingTop="7dp"
            android:paddingEnd="13dp"
            android:paddingBottom="7dp"
            android:text="@string/show_reply"
            android:textAllCaps="false"
            android:textColor="@color/v3_text_2"
            android:textSize="12sp"
            android:textStyle="bold"
            app:ptb_progress_stroke_width="3dp"
            app:ptb_progress_width="14dp" />

        <ceui.pixiv.widgets.ProgressTextButton
            android:id="@+id/delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/v3_action_pill_bg"
            android:drawablePadding="5dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="11dp"
            android:paddingTop="7dp"
            android:paddingEnd="13dp"
            android:paddingBottom="7dp"
            android:text="@string/string_219"
            android:textAllCaps="false"
            android:textColor="@color/v3_danger"
            android:textSize="12sp"
            android:textStyle="bold"
            app:ptb_progress_stroke_width="3dp"
            app:ptb_progress_width="14dp" />
    </LinearLayout>

    <!-- ═══ Nested reply thread ═══ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/child_comments_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="54dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/v3_comment_thread_bg"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
