<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v3_bg">

    <!-- 不给 include 设 id：会覆盖 Toolbar 自己的 @id/toolbar，setupV3Toolbar 就找不到它。 -->
    <include layout="@layout/toolbar_layout" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <!-- 功能说明卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_v3_card"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp">

                <TextView
                    style="@style/textMontserratBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/webdav_settings_title"
                    android:textColor="@color/v3_text_1"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/webdav_intro_body"
                    android:textColor="@color/v3_text_2"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 服务器卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_v3_card"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp">

                <TextView
                    style="@style/textMontserratBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/webdav_server_section"
                    android:textColor="@color/v3_text_1"
                    android:textSize="16sp" />

                <!-- 服务器地址 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/webdav_url_label"
                    android:textColor="@color/v3_text_3"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/webdav_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:autofillHints=""
                    android:background="@drawable/bg_v3_chip"
                    android:fontFamily="monospace"
                    android:hint="@string/webdav_url_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri|textNoSuggestions"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/v3_text_1"
                    android:textColorHint="@color/v3_text_3"
                    android:textSize="14sp" />

                <!-- 常用服务一键填入 -->
                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:flexWrap="wrap">

                    <TextView
                        android:id="@+id/webdav_preset_jianguoyun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_v3_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="@string/webdav_preset_jianguoyun"
                        android:textColor="@color/v3_text_2"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/webdav_preset_pcloud"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_v3_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="pCloud"
                        android:textColor="@color/v3_text_2"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/webdav_preset_pcloud_eu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_v3_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="pCloud EU"
                        android:textColor="@color/v3_text_2"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />
                </com.google.android.flexbox.FlexboxLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/webdav_url_desc"
                    android:textColor="@color/v3_text_3"
                    android:textSize="12sp" />

                <!-- 账号 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/webdav_username_label"
                    android:textColor="@color/v3_text_3"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/webdav_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:autofillHints="username"
                    android:background="@drawable/bg_v3_chip"
                    android:hint="@string/webdav_username_hint"
                    android:inputType="textEmailAddress|textNoSuggestions"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/v3_text_1"
                    android:textColorHint="@color/v3_text_3"
                    android:textSize="14sp" />

                <!-- 密码 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/webdav_password_label"
                    android:textColor="@color/v3_text_3"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/webdav_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:background="@drawable/bg_v3_chip"
                        android:fontFamily="monospace"
                        android:hint="@string/webdav_password_hint"
                        android:inputType="textPassword|textNoSuggestions"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="48dp"
                        android:paddingVertical="12dp"
                        android:textColor="@color/v3_text_1"
                        android:textColorHint="@color/v3_text_3"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/webdav_password_toggle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/webdav_toggle_password_visibility"
                        android:padding="9dp"
                        android:src="@drawable/ic_visibility_off_black_24dp"
                        app:tint="@color/v3_text_3" />
                </FrameLayout>

                <!-- 备份目录 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/webdav_folder_label"
                    android:textColor="@color/v3_text_3"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/webdav_folder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:autofillHints=""
                    android:background="@drawable/bg_v3_chip"
                    android:fontFamily="monospace"
                    android:hint="@string/webdav_folder_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri|textNoSuggestions"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/v3_text_1"
                    android:textColorHint="@color/v3_text_3"
                    android:textSize="14sp" />

                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:flexWrap="wrap">

                    <TextView
                        android:id="@+id/webdav_save_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="22dp"
                        android:text="@string/aria2_btn_save"
                        android:textSize="14sp" />

                    <ceui.pixiv.widgets.ProgressTextButton
                        android:id="@+id/webdav_test_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:text="@string/aria2_btn_test"
                        android:textSize="14sp"
                        app:ptb_progress_stroke_width="3dp"
                        app:ptb_progress_width="14dp" />
                </com.google.android.flexbox.FlexboxLayout>
            </LinearLayout>

            <!-- 备份卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_v3_card"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp">

                <TextView
                    style="@style/textMontserratBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/webdav_backup_section"
                    android:textColor="@color/v3_text_1"
                    android:textSize="16sp" />

                <!-- 包含浏览记录 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/webdav_include_history_title"
                        android:textColor="@color/v3_text_1"
                        android:textSize="16sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/webdav_include_history_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/webdav_include_history_desc"
                    android:textColor="@color/v3_text_3"
                    android:textSize="12sp" />

                <!-- 每日自动备份 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/webdav_auto_backup_title"
                        android:textColor="@color/v3_text_1"
                        android:textSize="16sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/webdav_auto_backup_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/webdav_auto_backup_desc"
                    android:textColor="@color/v3_text_3"
                    android:textSize="12sp" />

                <!-- 上次备份结果 -->
                <TextView
                    android:id="@+id/webdav_last_run"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="@color/v3_text_2"
                    android:textSize="13sp" />

                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:flexWrap="wrap">

                    <ceui.pixiv.widgets.ProgressTextButton
                        android:id="@+id/webdav_backup_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="22dp"
                        android:text="@string/webdav_btn_backup"
                        android:textSize="14sp"
                        app:ptb_progress_stroke_width="3dp"
                        app:ptb_progress_width="14dp" />

                    <ceui.pixiv.widgets.ProgressTextButton
                        android:id="@+id/webdav_restore_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:text="@string/webdav_btn_restore"
                        android:textSize="14sp"
                        app:ptb_progress_stroke_width="3dp"
                        app:ptb_progress_width="14dp" />
                </com.google.android.flexbox.FlexboxLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
