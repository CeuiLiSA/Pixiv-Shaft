<?xml version="1.0" encoding="utf-8"?>
<!--
  货架里的一件作品。120dp 见方 + 玻璃面压边（对齐 cell_v3_author_work），
  正方形是刻意的：横向条里尺寸一致才扫得快，宽高比留给瀑布流那一栏去表达。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">

        <!-- clickable 是 ripple 的前提，但它也会把点击吃在这一层、传不到 root，
             所以点击监听必须同时挂在这个 box 和 root 上（见 bind）。 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/work_box"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/v3_ripple_card14">

            <ImageView
                android:id="@+id/work_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/v3_surface_2"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/v3_glass_surface"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/badge_r18"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/v3_novel_r18_badge_bg"
                android:includeFontPadding="false"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:text="@string/v3_novel_r18"
                android:textColor="@android:color/white"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/pages_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/v3_badge_pages_bg"
                android:includeFontPadding="false"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="3P"
                tools:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/work_title"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/v3_text_2"
            android:textSize="11sp"
            tools:text="アナイクス" />

        <TextView
            android:id="@+id/work_author"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/v3_text_3"
            android:textSize="10sp"
            tools:text="作者名" />
    </LinearLayout>
</layout>
