<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v3_bg">

    <include
        android:id="@+id/toolbar_layout"
        layout="@layout/toolbar_layout" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <!-- 功能说明卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_v3_card"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/textMontserratBold"
                    android:text="@string/ai_translate_settings_title"
                    android:textColor="@color/v3_text_1"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/ai_translate_intro_body"
                    android:textColor="@color/v3_text_2"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 配置卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_v3_card"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp">

                <!-- 启用开关 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ai_translate_enable_title"
                        android:textColor="@color/v3_text_1"
                        android:textSize="16sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/ai_translate_enable_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/ai_translate_enable_desc"
                    android:textColor="@color/v3_text_3"
                    android:textSize="12sp" />

                <!-- Base URL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/ai_translate_base_url_label"
                    android:textColor="@color/v3_text_3"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/ai_translate_base_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:autofillHints=""
                    android:background="@drawable/bg_v3_chip"
                    android:fontFamily="monospace"
                    android:hint="@string/ai_translate_base_url_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri|textNoSuggestions"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/v3_text_1"
                    android:textColorHint="@color/v3_text_3"
                    android:textSize="14sp" />

                <!-- 常用服务一键填入(服务名是专名,不进翻译) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ai_translate_preset_openai"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_v3_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="OpenAI"
                        android:textColor="@color/v3_text_2"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/ai_translate_preset_deepseek"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_v3_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="DeepSeek"
                        android:textColor="@color/v3_text_2"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/ai_translate_preset_siliconflow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_v3_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="SiliconFlow"
                        android:textColor="@color/v3_text_2"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- API key -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/ai_translate_api_key_label"
                    android:textColor="@color/v3_text_3"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/ai_translate_api_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints=""
                        android:background="@drawable/bg_v3_chip"
                        android:fontFamily="monospace"
                        android:hint="@string/ai_translate_api_key_hint"
                        android:importantForAutofill="no"
                        android:inputType="textPassword|textNoSuggestions"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="48dp"
                        android:paddingVertical="12dp"
                        android:textColor="@color/v3_text_1"
                        android:textColorHint="@color/v3_text_3"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/ai_translate_api_key_toggle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/ai_translate_toggle_key_visibility"
                        android:padding="9dp"
                        android:src="@drawable/ic_visibility_off_black_24dp"
                        app:tint="@color/v3_text_3" />
                </FrameLayout>

                <!-- 模型名(右侧可从接口拉取列表) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ai_translate_model_label"
                        android:textColor="@color/v3_text_3"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/ai_translate_fetch_models_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="@string/ai_translate_fetch_models"
                        android:textColor="#6C5CE7"
                        android:textSize="13sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/ai_translate_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:autofillHints=""
                    android:background="@drawable/bg_v3_chip"
                    android:fontFamily="monospace"
                    android:hint="@string/ai_translate_model_hint"
                    android:importantForAutofill="no"
                    android:inputType="text|textNoSuggestions"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/v3_text_1"
                    android:textColorHint="@color/v3_text_3"
                    android:textSize="14sp" />

                <!-- 自定义提示词 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/ai_translate_prompt_label"
                    android:textColor="@color/v3_text_3"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/ai_translate_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:autofillHints=""
                    android:background="@drawable/bg_v3_chip"
                    android:gravity="top"
                    android:hint="@string/ai_translate_prompt_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:maxLines="6"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/v3_text_1"
                    android:textColorHint="@color/v3_text_3"
                    android:textSize="14sp" />

                <!-- 关闭思考(默认 / thinking / enable_thinking) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/ai_translate_thinking_label"
                    android:textColor="@color/v3_text_3"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/ai_translate_thinking_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_v3_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/v3_text_1"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/ai_translate_thinking_desc"
                    android:textColor="@color/v3_text_3"
                    android:textSize="12sp" />

                <!-- 流式传输开关 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ai_translate_streaming_title"
                        android:textColor="@color/v3_text_1"
                        android:textSize="16sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/ai_translate_streaming_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- 读取超时 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/ai_translate_read_timeout_label"
                    android:textColor="@color/v3_text_3"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/ai_translate_read_timeout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:autofillHints=""
                    android:background="@drawable/bg_v3_chip"
                    android:fontFamily="monospace"
                    android:hint="@string/ai_translate_read_timeout_placeholder"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/v3_text_1"
                    android:textColorHint="@color/v3_text_3"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/ai_translate_read_timeout_hint"
                    android:textColor="@color/v3_text_3"
                    android:textSize="12sp" />

                <!-- 操作按钮 -->
                <TextView
                    android:id="@+id/ai_translate_test_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="@color/v3_text_2"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ai_translate_save_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_v3_pill_primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="22dp"
                        android:paddingVertical="11dp"
                        android:text="@string/aria2_btn_save"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <ceui.pixiv.widgets.ProgressTextButton
                        android:id="@+id/ai_translate_test_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_v3_pill_secondary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="11dp"
                        android:text="@string/ai_translate_btn_test"
                        android:textColor="#6C5CE7"
                        android:textSize="14sp"
                        app:ptb_progress_stroke_width="3dp"
                        app:ptb_progress_width="14dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
