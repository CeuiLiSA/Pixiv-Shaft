<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="mmkv/pixshaft-auth-v2" />
        <exclude domain="file" path="mmkv/pixshaft-auth-v2.crc" />
        <!-- 动图 AI 补帧开关(RifePrefs):开 = 本机补帧模型已落盘,而模型与 librife_ncnn.so 都不跨设备,
             带过去只会得到一个「开着但没有模型」的空壳。整份排除,换机 / 还原后读到的就是默认 false。 -->
        <exclude domain="file" path="mmkv/rife_state_v1" />
        <exclude domain="file" path="mmkv/rife_state_v1.crc" />
        <!-- WebDAV 密码的密文绑在不可迁移的 Android-Keystore 密钥上；整份排除，换机后重新填写。 -->
        <exclude domain="file" path="mmkv/webdav_v1" />
        <exclude domain="file" path="mmkv/webdav_v1.crc" />
        <!-- 首页推荐包含 R-18 开关(HomeR18Prefs): 依赖本机网页登录 Cookie (PHPSESSID)，不具备跨设备性。
             整份排除，换机 / 还原后读到的就是默认 false。 -->
        <exclude domain="file" path="mmkv/home_r18_prefs_v1" />
        <exclude domain="file" path="mmkv/home_r18_prefs_v1.crc" />
        <!-- Chrome Custom Tabs 开关(ChromeTabsPrefs): 依赖本机是否安装 Chrome，不具备跨设备性。
             整份排除，换机 / 还原后读到的就是默认状态。 -->
        <exclude domain="file" path="mmkv/chrome_tabs_prefs_v1" />
        <exclude domain="file" path="mmkv/chrome_tabs_prefs_v1.crc" />
        <!-- 离线快照索引(SnapshotIndex 的 MMKV 表)：只是「UUID → 作品 ID」的本机缓存，
             指向的目录在别的设备上并不存在，带过去只会得到一堆点开就报错的条目。
             整份排除；换机 / 还原后首次启动会自己扫一遍重建（不影响任何用户数据）。 -->
        <exclude domain="file" path="mmkv/snapshot_index_v1" />
        <exclude domain="file" path="mmkv/snapshot_index_v1.crc" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="mmkv/pixshaft-auth-v2" />
        <exclude domain="file" path="mmkv/pixshaft-auth-v2.crc" />
        <!-- 动图 AI 补帧开关(RifePrefs):开 = 本机补帧模型已落盘,而模型与 librife_ncnn.so 都不跨设备,
             带过去只会得到一个「开着但没有模型」的空壳。整份排除,换机 / 还原后读到的就是默认 false。 -->
        <exclude domain="file" path="mmkv/rife_state_v1" />
        <exclude domain="file" path="mmkv/rife_state_v1.crc" />
        <!-- WebDAV 密码的密文绑在不可迁移的 Android-Keystore 密钥上；整份排除，换机后重新填写。 -->
        <exclude domain="file" path="mmkv/webdav_v1" />
        <exclude domain="file" path="mmkv/webdav_v1.crc" />
        <!-- 首页推荐包含 R-18 开关(HomeR18Prefs): 依赖本机网页登录 Cookie (PHPSESSID)，不具备跨设备性。
             整份排除，换机 / 还原后读到的就是默认 false。 -->
        <exclude domain="file" path="mmkv/home_r18_prefs_v1" />
        <exclude domain="file" path="mmkv/home_r18_prefs_v1.crc" />
        <!-- Chrome Custom Tabs 开关(ChromeTabsPrefs): 依赖本机是否安装 Chrome，不具备跨设备性。
             整份排除，换机 / 还原后读到的就是默认状态。 -->
        <exclude domain="file" path="mmkv/chrome_tabs_prefs_v1" />
        <exclude domain="file" path="mmkv/chrome_tabs_prefs_v1.crc" />
        <!-- 离线快照索引(SnapshotIndex 的 MMKV 表)：只是「UUID → 作品 ID」的本机缓存，
             指向的目录在别的设备上并不存在，带过去只会得到一堆点开就报错的条目。
             整份排除；换机 / 还原后首次启动会自己扫一遍重建（不影响任何用户数据）。 -->
        <exclude domain="file" path="mmkv/snapshot_index_v1" />
        <exclude domain="file" path="mmkv/snapshot_index_v1.crc" />
    </device-transfer>
</data-extraction-rules>
