        <item name="android:textColor">@color/text00</item>
        <item name="android:textSize">12sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- Chat subsystem (borrowed from Peanut; see ceui.pixiv.chat.*). -->
    <style name="Chat.ActionRow" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ShapeAppearance.Chat.Avatar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.Chat.Bubble.Sent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">20dp</item>
        <item name="cornerSizeBottomRight">4dp</item>
    </style>

    <style name="ShapeAppearance.Chat.Bubble.Received" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">4dp</item>
        <item name="cornerSizeBottomRight">20dp</item>
    </style>

    <!--
      站长推荐 score pill。封面左上叠层,金渐变背景 + 琥珀金字 + 黑 shadow。
      默认 visibility=gone,只有 trending repo 把 score 注入到 bean 时才显示。
      插画卡(IAdapter)与小说卡(NovelFeedFragment 的 renderer)共用,与现有 tag_stroke 风格
      刻意区分以表明语义不同。
    -->
    <style name="TrendingScorePill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_trending_score_pill</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">@color/trending_score_amber</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:shadowColor">#000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- ── MD3-E 设置页 ─────────────────────────────────────────── -->

    <!-- 分段分组里的一行（背景按位置用 bg_m3_row_top/mid/bottom/single） -->
    <style name="M3SetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- 行内文字列（标题+描述），给右侧开关/值留出空间 -->
    <style name="M3SetTexts">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:layout_marginEnd">64dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="M3SetTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/v3_text_1</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="M3SetDesc">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/v3_text_2</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 右侧当前值（可点行的 value 文本） -->
    <style name="M3SetValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:maxWidth">150dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 右侧箭头（导航行），可带状态文字 -->
    <style name="M3SetArrow" parent="M3SetValue">
        <item name="android:drawableEnd">@drawable/ic_arrow_right</item>
        <item name="android:drawablePadding">@dimen/six_dp</item>
    </style>

    <!-- MD3 风格开关 -->
    <style name="M3SetSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="track">@drawable/m3_switch_track</item>
        <item name="android:thumb">@drawable/m3_switch_thumb</item>
        <item name="android:background">@null</item>
    </style>

    <!-- 分类页内的小节标题 -->
    <style name="M3SetHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">18dp</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- MD3-E 阅读器滑块:主题色激活轨 + 竖胶囊手柄,轨道 6dp。 -->
    <style name="Widget.Reader.Slider" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/reader_slider_progress</item>
        <item name="android:thumb">@drawable/reader_slider_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:thumbOffset">0dp</item>
        <item name="android:maxHeight">6dp</item>
        <item name="android:minHeight">6dp</item>
        <item name="android:paddingStart">3dp</item>
        <item name="android:paddingEnd">3dp</item>
    </style>

    <!-- 分组卡内 inset 分割线(起始 18dp 内缩,与行内容对齐)。 -->
    <style name="ReaderRowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:layout_marginStart">18dp</item>
        <item name="android:background">@color/v3_border_2</item>
    </style>

</resources>


