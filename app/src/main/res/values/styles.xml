    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/PixivBottomSheetStyle</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:ignore="NewApi">@android:color/transparent</item>
    </style>

    <!-- V3 系列 sheet 专用：开启 edgeToEdge，让 sheet 背景覆盖到 gesture nav 区域，
         避免「sheet 底部和系统栏之间露出 scrim」的视觉空隙。
         [ceui.pixiv.ui.search.v3.V3BottomSheetBase] 在 onStart 里再把 Material 给
         design_bottom_sheet 装的 inset listener 摘掉——content 的 nav bar padding
         由 V3 sheet 自己在 root 上做，统一一处。 -->
    <style name="ThemeOverlay.V3.BottomSheetDialog" parent="ThemeOverlay.App.BottomSheetDialog">
        <item name="enableEdgeToEdge">true</item>
    </style>

    <!-- reader / novel / comic 的下载·导出·设置类 sheet 共用:开启 edgeToEdge,让 dialog
         window 画到手势导航栏底下。配合各 sheet 的 letDrawBehindNavBar()(清掉 Material 给
         design_bottom_sheet 垫的 nav inset padding),sheet 内容背景就能一路延伸进底部 safe
         area,消除底部露出后面页面的空隙。
         注意 parent 必须是 ThemeOverlay.App.BottomSheetDialog(它的 bottomSheetStyle 走老 design
         库的 Widget.Design.BottomSheet.Modal)。若 parent 用 ThemeOverlay.Material3.BottomSheetDialog,
         其默认 Widget.Material3.BottomSheet.Modal 的 BottomSheetBehavior 会去读本 App 主题里
         缺失的 Material3 motion 属性,inflate 直接崩(design_bottom_sheet_dialog line #47)。
         与 ThemeOverlay.V3.BottomSheetDialog 等价,只是命名更中性、给非 V3 包复用。 -->
    <style name="ThemeOverlay.App.BottomSheetDialog.EdgeToEdge" parent="ThemeOverlay.App.BottomSheetDialog">
        <item name="enableEdgeToEdge">true</item>
    </style>

    <style name="UpdateBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_update_bottom_sheet</item>
    </style>

    <style name="Theme.Update.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
