<resources>
    <string name="transfer_title">换机迁移</string>
    <string name="transfer_settings_summary">通过同一个 Wi‑Fi 把本机数据迁到新手机</string>
    <string name="transfer_home_title">把本地数据带到新手机</string>
    <string name="transfer_home_body">两台手机连接同一个 Wi‑Fi，并登录同一个 Pixiv 账号。数据在两台手机之间加密传输。</string>
    <string name="transfer_login_body">请先登录 Pixiv，再回来开始迁移。</string>
    <string name="transfer_login">登录 Pixiv</string>
    <string name="transfer_receive">新手机 · 扫码接收</string>
    <string name="transfer_old_phone">旧手机 · 生成二维码</string>
    <string name="transfer_contents_title">会迁移哪些数据</string>
    <string name="transfer_contents_body">应用和下载设置、屏蔽记录、搜索和浏览历史、置顶标签和作者、稍后再看、精华收藏、同义词词典和已保存的账号。已下载文件、缓存和系统授予的目录权限需要在新手机上另行处理。</string>
    <string name="transfer_pair_title">用新手机扫描二维码</string>
    <string name="transfer_pair_body">在新手机的换机迁移页选择「扫码接收」。此二维码仅供本次迁移使用，有效期为 2 分钟。</string>
    <string name="transfer_pair_qr">换机迁移二维码</string>
    <string name="transfer_approve_title">向新手机发送数据？</string>
    <string name="transfer_approve_body">核对两台手机上的配对数字一致后再发送。备份包含已保存的账号和应用设置。</string>
    <string name="transfer_comparison">配对数字 %1$s</string>
    <string name="transfer_send">确认发送</string>
    <string name="transfer_scan_title">扫描旧手机的二维码</string>
    <string name="transfer_scan_body">请将旧手机换机迁移页的二维码放入取景区域。</string>
    <string name="transfer_cancel">取消迁移</string>
    <string name="transfer_connecting">正在准备连接</string>
    <string name="transfer_wait">等待旧手机确认</string>
    <string name="transfer_wait_body">请在旧手机上核对配对数字，再点「确认发送」。</string>
    <string name="transfer_prepare">正在打包备份</string>
    <string name="transfer_keep_open">请保持两台手机连接 Wi‑Fi，并停留在迁移页面。</string>
    <string name="transfer_sending">正在发送备份</string>
    <string name="transfer_receiving">正在接收备份</string>
    <string name="transfer_remote_restore">新手机正在恢复</string>
    <string name="transfer_restoring">正在恢复数据</string>
    <string name="transfer_percent">%1$d%%</string>
    <string name="transfer_complete">迁移完成</string>
    <string name="transfer_sent_body">新手机已完成恢复。旧手机上的数据仍可继续使用。</string>
    <string name="transfer_restored_body">本地记录已合并，应用和下载设置已导入。部分设置会在重启应用后生效。</string>
    <string name="transfer_done">完成</string>
    <string name="transfer_error_title">迁移未完成</string>
    <string name="transfer_error_wifi">无法通过 Wi‑Fi 连接。请让两台手机连接同一个 Wi‑Fi，并允许设备之间互相访问。</string>
    <string name="transfer_error_account">请在两台手机上登录同一个 Pixiv 账号，再重新配对。</string>
    <string name="transfer_error_timeout">连接已超时。请在旧手机上重新生成二维码。</string>
    <string name="transfer_error_connection">无法连接或传输已中断。请确认 Wi‑Fi 连接正常、两台手机有足够的剩余空间，再重新配对。</string>
    <string name="transfer_error_restore">新手机无法恢复这份备份。请确认存储空间充足，更新两台手机上的应用后重试。</string>
    <string name="transfer_error_status_unknown">旧手机未收到恢复结果。请在新手机上查看迁移状态。</string>
    <string name="transfer_status_unknown_title">等待确认恢复结果</string>
    <string name="transfer_error_code">此二维码无法用于迁移。请扫描旧手机在换机迁移页生成的二维码。</string>
    <string name="transfer_error_camera_permission">扫码需要相机权限。请允许使用相机。如果系统未再次询问，可在系统设置中开启。</string>
    <string name="transfer_error_camera">相机无法打开。请关闭其他正在使用相机的应用后重试。</string>
    <string name="transfer_retry">重试</string>
    <string name="transfer_back">返回</string>
