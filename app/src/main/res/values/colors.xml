    <!-- V3 Detail — Light Mode

         下面写成 @color/wit_* 的这批是**引用别名**，真值在 :witstudio 的
         values{,-night}/wit_colors.xml 里，夜间值也只活在那边（本文件的 values-night 版已删除对应条目）。

         为什么不直接把资源搬走、让调用方改用 wit_* 名字：本仓 nonTransitiveRClass 是开的
         （AGP 8 默认），资源一旦挪进模块，:app 里 191 处 `R.color.v3_*`
         代码引用就没有一个 R 装得下了。留别名则 XML（约 800 处）和代码（191 处）全部零改动，
         色值仍只有一份、不会漂移。

         ⚠️ 别在这里写回具体色值——那会静默遮蔽模块的夜间值，且不会有任何编译期报错。
         改色去 :witstudio/src/main/res/values{,-night}/wit_colors.xml。
         别名清理（统一改名成 wit_*）是计划里的 phase 7，纯审美，可无限期推迟。 -->
    <color name="v3_bg">@color/wit_bg</color>
    <color name="v3_surface_1">@color/wit_surface_1</color>
    <color name="v3_surface_2">@color/wit_surface_2</color>
    <color name="v3_surface_3">@color/wit_surface_3</color>
    <!-- feed_skeleton_block / feed_skeleton_highlight 已随骨架图搬进 :feeds 模块
         (feeds/src/main/res/values/colors.xml)，经资源合并本模块照常引用得到。 -->
    <!-- 进度条未完成段：比 v3_surface_2/3 对比更强，让 dark 模式下能清楚看到 track -->
    <color name="v3_progress_track">@color/wit_progress_track</color>
    <color name="v3_border_1">@color/wit_border_1</color>
    <color name="v3_border_2">@color/wit_border_2</color>
    <color name="v3_menu_bg">@color/wit_menu_bg</color>
    <!-- 长按选中文字的高亮底色。QMUI 的 TextView.Compat 把它钉成了不透明的
         qmui_config_color_background_pressed(#EEEFF1),且库里没有 night 版:夜间近白正文
         压在浅灰块上直接看不见,日间那块浅灰压在白底上又几乎看不出选中(#973)。
         日间改用 v3_blue 30% scrim(和 bulk_select_scrim 同值,选中态语言统一),
         夜间见 values-night。主题色有 10 套(含亮黄 #fee65e),所以不跟 colorPrimary 走。 -->
    <color name="text_selection_highlight">#4D2B6FCC</color>
