<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SparkText">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/montserrat_regular</item><item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/v3_text_1</item><item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="SparkText.Label"><item name="android:fontFamily">@font/montserrat_semi_bold</item><item name="android:textSize">12sp</item></style>
    <style name="SparkText.Heading"><item name="android:fontFamily">@font/montserrat_bold</item><item name="android:textSize">20sp</item></style>
    <style name="SparkButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item><item name="android:minWidth">48dp</item><item name="android:paddingStart">16dp</item><item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item><item name="android:paddingBottom">10dp</item><item name="android:fontFamily">@font/montserrat_semi_bold</item><item name="android:textSize">14sp</item><item name="android:textAllCaps">false</item><item name="android:stateListAnimator">@null</item>
    </style>
    <style name="SparkInput" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">52dp</item><item name="android:padding">14dp</item><item name="android:textSize">16sp</item><item name="android:fontFamily">@font/montserrat_regular</item><item name="android:textColor">@color/v3_text_1</item><item name="android:textColorHint">@color/v3_text_2</item><item name="android:lineSpacingExtra">5dp</item><item name="android:background">@drawable/bg_v3_surface</item><item name="android:gravity">top|start</item><item name="android:inputType">textCapSentences|textMultiLine</item>
    </style>
    <style name="SparkIconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">48dp</item><item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item><item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/v3_action_pill_bg</item>
        <item name="android:tint">@color/always_white</item><item name="android:contentDescription">@string/spark_lab_send</item>
    </style>
</resources>
