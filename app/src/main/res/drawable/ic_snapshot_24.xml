<?xml version="1.0" encoding="utf-8"?>
<!--
  离线快照图标：以相片为画框主体，右上角融合断网云（Cloud Off）。
  山峰融进边框底边无缝一体，深峰谷挺拔险峻，断网云精准传递「离线缓存 / 本地化快照」心智。
  用于侧边栏导航、作品详情页动作菜单等入口。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <!-- 相框主体与山峰一体 (深峰谷 y=17.3，融进底边无缝) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M9.8,4H5c-1.1,0 -2,0.9 -2,2v13c0,1.1 0.9,2 2,2h14c1.1,0 2,-0.9 2,-2v-5.4h-2V19l-4.4,-5 -3.3,3.3 -2.8,-4.3L5,19V6h4.8V4z" />

    <!-- 太阳 -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M7,8.2a1.3,1.3 0 1,0 0,2.6 1.3,1.3 0 1,0 0,-2.6z" />

    <!-- 描边断网云 (1.4dp 细腻圆润轮廓，参考图 1:1 精确复刻) -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M13.2,9.4h7.8a1.9,1.9 0 0,0 0.4,-3.7 2.9,2.9 0 0,0 -5.5,-1.1 2.2,2.2 0 0,0 -3.5,1.7 1.8,1.8 0 0,0 0.8,3.1z" />

    <!-- 贯穿斜划线 (\ 走向，两端圆角) -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M12.0,2.4L22.2,11.4" />
</vector>
