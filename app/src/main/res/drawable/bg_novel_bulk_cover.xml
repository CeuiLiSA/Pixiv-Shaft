<?xml version="1.0" encoding="utf-8"?>
<!--
  小说批量选择行的封面底框。同 bulk_select_cell_bg 的语言（占位色 + hairline），
  只是圆角收到 10dp —— 那份是给 3 列大格子用的 14dp，套在这里 52dp 宽的小封面上
  会圆得几乎看不出是张图。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/v3_surface_2" />
    <stroke
        android:width="1dp"
        android:color="@color/v3_border_2" />
    <corners android:radius="10dp" />
</shape>
