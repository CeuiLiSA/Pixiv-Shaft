<?xml version="1.0" encoding="utf-8"?>
<!-- 「翻译整部」悬浮小窗底:AI 功能统一的深靛蓝玻璃面(对齐 bg_upscale_gradient 的色系),
     紫调细描边,压在任何漫画页上都有层次。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#F20F0F22"
                android:centerColor="#F2141432"
                android:endColor="#F20C0C1E" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#4D6C5CE7" />
        </shape>
    </item>
    <!-- 顶部一抹高光,做出玻璃反光 -->
    <item
        android:bottom="36dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1AFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
