<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="transfer_title">手機資料移轉</string>
    <string name="transfer_settings_summary">透過同一個 Wi-Fi 把本機資料移轉到新手機</string>
    <string name="transfer_home_title">把本機資料帶到新手機</string>
    <string name="transfer_home_body">請將兩台手機連上同一個 Wi-Fi，並登入同一個 Pixiv 帳號。資料會在兩台手機之間加密傳輸。</string>
    <string name="transfer_login_body">請先登入 Pixiv，再開始移轉。</string>
    <string name="transfer_login">登入 Pixiv</string>
    <string name="transfer_receive">新手機 · 掃碼接收</string>
    <string name="transfer_old_phone">舊手機 · 產生 QR 碼</string>
    <string name="transfer_contents_title">可移轉的資料</string>
    <string name="transfer_contents_body">應用程式和下載設定、封鎖記錄、搜尋和瀏覽記錄、釘選的標籤和作者、稍後再看、精選收藏、同義詞字典和已儲存的帳號。下載檔案、快取和系統資料夾權限需要另行處理。</string>
    <string name="transfer_pair_title">用新手機掃描 QR 碼</string>
    <string name="transfer_pair_body">在新手機的資料移轉頁面選擇「掃碼接收」。此 QR 碼只能使用一次，有效期為 2 分鐘。</string>
    <string name="transfer_pair_qr">手機資料移轉 QR 碼</string>
    <string name="transfer_approve_title">要將資料傳送到新手機嗎？</string>
    <string name="transfer_approve_body">確認兩台手機上的配對數字相同後再傳送。備份包含已儲存的帳號和應用程式設定。</string>
    <string name="transfer_comparison">配對數字 %1$s</string>
    <string name="transfer_send">確認傳送</string>
    <string name="transfer_scan_title">掃描舊手機的 QR 碼</string>
    <string name="transfer_scan_body">請將舊手機資料移轉頁面上的 QR 碼對準取景框。</string>
    <string name="transfer_cancel">取消移轉</string>
    <string name="transfer_connecting">正在準備連線</string>
    <string name="transfer_wait">等待舊手機確認</string>
    <string name="transfer_wait_body">請在舊手機上核對配對數字，再點選「確認傳送」。</string>
    <string name="transfer_prepare">正在準備備份</string>
    <string name="transfer_keep_open">請讓兩台手機保持 Wi-Fi 連線，並停留在資料移轉頁面。</string>
    <string name="transfer_sending">正在傳送備份</string>
    <string name="transfer_receiving">正在接收備份</string>
    <string name="transfer_remote_restore">新手機正在還原</string>
    <string name="transfer_restoring">正在還原資料</string>
    <string name="transfer_percent">%1$d%%</string>
    <string name="transfer_complete">移轉完成</string>
    <string name="transfer_sent_body">新手機已完成還原。舊手機上的資料仍可繼續使用。</string>
    <string name="transfer_restored_body">本機記錄已合併，並已匯入應用程式和下載設定。部分設定會在重新啟動應用程式後生效。</string>
    <string name="transfer_done">完成</string>
    <string name="transfer_error_title">移轉未完成</string>
    <string name="transfer_error_wifi">無法透過 Wi-Fi 連線。請確認兩台手機連上同一個 Wi-Fi，且裝置之間可互相存取。</string>
    <string name="transfer_error_account">請在兩台手機上登入同一個 Pixiv 帳號，再重新配對。</string>
    <string name="transfer_error_timeout">連線逾時。請在舊手機上重新產生 QR 碼。</string>
    <string name="transfer_error_connection">無法連線或傳輸中斷。請確認兩台手機的 Wi-Fi 連線和剩餘儲存空間，再重新配對。</string>
    <string name="transfer_error_restore">新手機無法還原這份備份。請確認剩餘儲存空間，更新兩台手機上的應用程式後再試一次。</string>
    <string name="transfer_error_status_unknown">舊手機未收到還原結果。請在新手機上查看移轉狀態。</string>
    <string name="transfer_status_unknown_title">還原結果尚未確認</string>
    <string name="transfer_error_code">此 QR 碼無法用於移轉。請掃描舊手機在資料移轉頁面上產生的 QR 碼。</string>
    <string name="transfer_error_camera_permission">掃碼需要相機權限。如果系統未再次詢問，可在系統設定中開啟權限。</string>
    <string name="transfer_error_camera">無法開啟相機。請關閉其他正在使用相機的應用程式後再試一次。</string>
    <string name="transfer_retry">再試一次</string>
    <string name="transfer_back">返回</string>
</resources>
